# Copy to .env and adjust before running `docker compose up -d --build`.

# Hostname or IP this server is publicly reachable under, e.g. cloud.example.com
# or 203.0.113.10. Baked into the dashboard at build time, so changing this
# later requires a rebuild (`docker compose up -d --build`).
PUBLIC_HOST=localhost

BACKEND_PORT=8080
DASHBOARD_PORT=3000
